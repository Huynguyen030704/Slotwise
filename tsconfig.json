{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "packages/core/src/**/*.js",
    "packages/core/test/**/*.js",
    "apps/mobile/app/**/*.js",
    "apps/mobile/src/**/*.js"
  ],
  "exclude": ["apps/mobile/**/*.test.js", "apps/mobile/src/test/**"]
}
